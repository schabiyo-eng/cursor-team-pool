# Copy to terraform.tfvars. Do not put a service account key in this file.
aws_region   = "us-east-1"
pool_name    = "lab"
# private_nat is the default and the recommended enterprise path.
# public_lab skips the NAT gateway cost and is lab-only.
network_mode = "private_nat" # private_nat (default) | public_lab (lab-only)
lab_egress   = false
# enable_ssm                 = false
# brittle_cursor_ip_egress   = false # leave false; CDN A records rotate

# instance_type    = "t3.small"
# ami_architecture = "x86_64"
# vpc_id           = null
# public_subnet_id = null
# secret_recovery_window_in_days = 0
